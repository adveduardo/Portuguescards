    {
      "a": "!  exclamação",
      "b": "expressa emoção: susto, alegria",
      "explica": "Que golaço!"
    },
    {
      "a": ",  vírgula",
      "b": "separa o vocativo e os itens de uma lista",
      "explica": "Ana, compre pão, leite e ovos."
