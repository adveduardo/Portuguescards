    {
      "a": ";  ponto e vírgula",
      "b": "separa orações longas e itens de leis",
      "explica": "Uns gostam de sol, praia e calor; outros, de frio."
    },
    {
      "a": ":  dois-pontos",
      "b": "anuncia lista, citação ou fala",
