{
  "titulo": "Batata quente da sintaxe",
  "perguntas": [
    {
      "pergunta": "Dê um exemplo de oração sem sujeito.",
      "resposta": "Exemplos: Choveu ontem. Há alunos na sala. Faz frio."
    },
    {
      "pergunta": "Dê um exemplo de sujeito composto.",
      "resposta": "Exemplo: Ana e Pedro viajaram."
    },
    {
      "pergunta": "Crase ou não? Vou ___ praia.",
      "resposta": "à"
    },
    {
      "pergunta": "Crase ou não? Fui ___ pé.",
      "resposta": "a (sem crase)"
    },
    {
      "pergunta": "Corrija: Haviam muitas pessoas.",
      "resposta": "Havia muitas pessoas."
    },
    {
      "pergunta": "Corrija: Fazem dois anos.",
      "resposta": "Faz dois anos."
    },
    {
      "pergunta": "Diga uma conjunção de oposição.",
      "resposta": "mas, porém, contudo, todavia, entretanto"
    },
    {
      "pergunta": "Diga uma conjunção de conclusão.",
      "resposta": "portanto, logo, por isso, assim"
    },
    {
      "pergunta": "Diga uma conjunção concessiva.",
      "resposta": "embora, ainda que, mesmo que, apesar de que"
    },
    {
      "pergunta": "Diga uma conjunção condicional.",
      "resposta": "se, caso, desde que"
    },
    {
      "pergunta": "O que é vocativo? Dê um exemplo.",
      "resposta": "Termo usado para chamar alguém. Ex.: João, venha cá!"
    },
    {
      "pergunta": "O que é aposto? Dê um exemplo.",
      "resposta": "Termo que explica outro. Ex.: Brasília, a capital, ..."
    },
    {
      "pergunta": "Complete: Assisti ___ filme.",
      "resposta": "ao"
    },
    {
      "pergunta": "Complete: Obedeça ___ regras.",
      "resposta": "às"
    },
    {
      "pergunta": "Em \"Gosto de pizza\", qual é o objeto indireto?",
      "resposta": "de pizza"
    },
    {
      "pergunta": "Em \"Comprei um livro\", qual é o objeto direto?",
      "resposta": "um livro"
    },
    {
      "pergunta": "Coloque o pronome: Não ___ disseram (me).",
      "resposta": "Não me disseram."
    },
    {
      "pergunta": "Precisa-se ou precisam-se de vendedores?",
      "resposta": "Precisa-se"
    },
    {
      "pergunta": "Vende-se ou vendem-se casas?",
      "resposta": "Vendem-se"
    },
    {
      "pergunta": "Que relação tem PORQUE em \"Faltei porque estava doente\"?",
      "resposta": "causa"
    }
  ]
}
