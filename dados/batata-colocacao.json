{
  "titulo": "Batata quente da colocação pronominal",
  "perguntas": [
    {
      "pergunta": "O que é próclise?",
      "resposta": "Pronome antes do verbo"
    },
    {
      "pergunta": "O que é ênclise?",
      "resposta": "Pronome depois do verbo, com hífen"
    },
    {
      "pergunta": "O que é mesóclise?",
      "resposta": "Pronome no meio do verbo (futuro)"
    },
    {
      "pergunta": "Diga uma palavra que atrai o pronome.",
      "resposta": "não, nunca, ninguém, que, quem, sempre, aqui…"
    },
    {
      "pergunta": "Coloque o pronome: Não ___ disseram (me).",
      "resposta": "Não me disseram."
    },
    {
      "pergunta": "Coloque o pronome: Entregarei ___ (te).",
      "resposta": "Entregar-te-ei."
    },
    {
      "pergunta": "Coloque o pronome: Diga ___ (me).",
      "resposta": "Diga-me."
    },
    {
      "pergunta": "Fazer + o =",
      "resposta": "fazê-lo"
    },
    {
      "pergunta": "Vender + a =",
      "resposta": "vendê-la"
    },
    {
      "pergunta": "Fiz + o =",
      "resposta": "fi-lo"
    },
    {
      "pergunta": "Viram + o =",
      "resposta": "viram-no"
    },
    {
      "pergunta": "Põe + o =",
      "resposta": "põe-no"
    },
    {
      "pergunta": "Corrija: Ninguém contou-me.",
      "resposta": "Ninguém me contou."
    },
    {
      "pergunta": "Corrija: Me empreste o lápis (norma-padrão).",
      "resposta": "Empreste-me o lápis."
    },
    {
      "pergunta": "Corrija: Faria-lhe um favor.",
      "resposta": "Far-lhe-ia um favor."
    },
    {
      "pergunta": "Corrija: Tenho esforçado-me.",
      "resposta": "Tenho-me esforçado."
    },
    {
      "pergunta": "Pode iniciar frase com pronome oblíquo na norma-padrão?",
      "resposta": "Não"
    },
    {
      "pergunta": "Com particípio, pode ênclise?",
      "resposta": "Nunca (o pronome vai no auxiliar)"
    },
    {
      "pergunta": "\"Deus te abençoe\": por que próclise?",
      "resposta": "Frase de desejo (optativa)"
    },
    {
      "pergunta": "Em + gerúndio pede…?",
      "resposta": "Próclise (em se tratando)"
    }
  ]
}
