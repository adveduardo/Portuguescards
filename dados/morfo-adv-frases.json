{
  "titulo": "Caça aos advérbios",
  "como_marcar": "Marque os advérbios com /d (ex.: devagar/d). As outras palavras ficam sem marca.",
  "frases": [
    "Ontem/d eu acordei cedo/d.",
    "O cachorro corre muito/d depressa/d.",
    "Nós moramos perto/d da escola.",
    "A vovó caminha devagar/d.",
    "Hoje/d não/d vai chover.",
    "Ela canta muito/d bem/d.",
    "Talvez/d eu viaje amanhã/d.",
    "Aqui/d tem muitos livros.",
    "O gato dormiu tranquilamente/d.",
    "Sempre/d escovo os dentes.",
    "O avião voa alto/d.",
    "Lá/d fora/d está frio.",
    "Estou bastante/d cansado.",
    "Ele chegou tarde/d.",
    "Fale baixo/d, por favor.",
    "Já/d terminei a lição.",
    "Certamente/d vamos ganhar!",
    "O bebê dorme ali/d.",
    "Eu nunca/d como jiló.",
    "Corra rapidamente/d!",
    "A bola está dentro/d da caixa."
  ]
}
