{
  "titulo": "Batata quente da fonologia",
  "perguntas": [
    {
      "pergunta": "Diga uma palavra com dígrafo.",
      "resposta": "chuva, carro, ninho, palha, pássaro…"
    },
    {
      "pergunta": "Diga uma palavra com encontro consonantal.",
      "resposta": "prato, blusa, livro, flor…"
    },
    {
      "pergunta": "Diga uma palavra com hiato.",
      "resposta": "saúde, lua, rio, poeta…"
    },
    {
      "pergunta": "Diga uma palavra com ditongo.",
      "resposta": "pai, mãe, céu, boi…"
    },
    {
      "pergunta": "Diga uma palavra com tritongo.",
      "resposta": "Paraguai, iguais, saguão"
    },
    {
      "pergunta": "Diga uma palavra proparoxítona.",
      "resposta": "música, árvore, pássaro…"
    },
    {
      "pergunta": "Diga uma palavra oxítona.",
      "resposta": "café, jacaré, sofá…"
    },
    {
      "pergunta": "Diga uma palavra paroxítona.",
      "resposta": "mesa, caderno, cadeira…"
    },
    {
      "pergunta": "Separe: pássaro.",
      "resposta": "pás-sa-ro"
    },
    {
      "pergunta": "Separe: advogado.",
      "resposta": "ad-vo-ga-do"
    },
    {
      "pergunta": "Separe: saúde.",
      "resposta": "sa-ú-de"
    },
    {
      "pergunta": "Separe: Paraguai.",
      "resposta": "Pa-ra-guai"
    },
    {
      "pergunta": "Quantos fonemas tem \"carro\"?",
      "resposta": "4"
    },
    {
      "pergunta": "Quantos fonemas tem \"fixo\"?",
      "resposta": "5 (o X vale ks)"
    },
    {
      "pergunta": "Qual é a sílaba tônica de \"rubrica\"?",
      "resposta": "BRI (ru-BRI-ca)"
    },
    {
      "pergunta": "Qual é a sílaba tônica de \"gratuito\"?",
      "resposta": "TUI (gra-TUI-to)"
    },
    {
      "pergunta": "Diga um monossílabo tônico.",
      "resposta": "pé, sol, mar, nós…"
    },
    {
      "pergunta": "Diga um monossílabo átono.",
      "resposta": "de, o, a, que, se, lhe…"
    },
    {
      "pergunta": "O que é dígrafo?",
      "resposta": "Duas letras que representam um só som"
    },
    {
      "pergunta": "O que é hiato?",
      "resposta": "Encontro de duas vogais em sílabas diferentes"
    }
  ]
}
